{
  "name": "routefinder-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that turns past COROS activities into a map of distinct repeated routes",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "routefinder-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
